# Keep line-ending normalization away from binary assets.
#
# Git on Windows warns "LF will be replaced by CRLF" for any file it treats as
# text. On a PDF or a PNG that is not cosmetic: a fresh clone with
# core.autocrlf=true would rewrite bytes on checkout and hand the next person a
# corrupt file. Marking these binary stops that.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.tar.gz binary
*.zip    binary

# Source is normalized to LF in the repository. Vercel builds on Linux, so LF is
# the correct stored form regardless of what a Windows working copy shows.
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.astro  text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.svg    text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
