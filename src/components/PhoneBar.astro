---
/**
 * Sticky mobile click-to-call (Keystone 1.1 #2, gate item in Part 9).
 * PENDING-GUARDED: with no confirmed phone number the bar shows the estimate
 * action only. It never renders a placeholder number.
 */
import { BUSINESS, has } from '../data/business';

interface Props {
  /** Named to this page's market, not a generic sitewide banner. */
  market?: string;
}
const { market } = Astro.props;
const phone = has(BUSINESS.phoneE164) ? BUSINESS.phoneE164 : null;
const label = market ? `Free ${market} Estimate` : 'Get a Free Estimate';
---

<div class="callbar" role="complementary" aria-label="Contact Quality Konnection">
  {
    phone && (
      <a class="primary" href={`tel:${phone}`} data-cta="call">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        Call Now
      </a>
    )
  }
  <a href="/contact/" class={phone ? '' : 'primary'} data-cta="quote">{label}</a>
</div>
